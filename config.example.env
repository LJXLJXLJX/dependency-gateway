DEPENDENCY_GATEWAY_STORAGE="s3"
DEPENDENCY_GATEWAY_DIR="/data/dependency-gateway"
DEPENDENCY_GATEWAY_CONFIG="config/sources.json"
DEPENDENCY_GATEWAY_S3_ENDPOINT="http://<s3-endpoint>"
DEPENDENCY_GATEWAY_S3_REGION="<region>"
DEPENDENCY_GATEWAY_S3_BUCKET="<bucket>"
DEPENDENCY_GATEWAY_S3_PREFIX="dependency-gateway"
DEPENDENCY_GATEWAY_S3_ACCESS_KEY_ID="<access-key-id>"
DEPENDENCY_GATEWAY_S3_SECRET_ACCESS_KEY="<secret-access-key>"
# DEPENDENCY_GATEWAY_S3_SESSION_TOKEN="<session-token>"
# DEPENDENCY_GATEWAY_UPSTREAM_PROXY="http://<proxy-host>:<proxy-port>"
DEPENDENCY_GATEWAY_CACHE_MODE="proxy-only"
# Optional GitHub prewarm/readiness plan. It is not a runtime repository allowlist.
# Bare mirrors live on a persistent filesystem.
# DEPENDENCY_GATEWAY_GIT_MIRROR_PLAN="/path/to/git-mirror-plan.json"
DEPENDENCY_GATEWAY_GIT_MIRROR_ROOT="/data/dependency-gateway/github_mirrors"

# Dataset image pre-upload (dependency-gateway-prepare). Keep real credentials only
# in the Git-ignored config.local.env.
# Conda dry-run resolver: a reviewed, already-loaded internal micromamba image.
# Docker runs it with --pull never; no Python package dependencies are added.
# DEPENDENCY_GATEWAY_CONDA_RESOLVER_IMAGE="<preloaded-internal-micromamba-image>"
YICLOUD_HARBOR_HOST="<internal-registry-host>"
YICLOUD_HARBOR_USERNAME="<registry-username>"
YICLOUD_HARBOR_PASSWORD="<registry-password>"
# DEPENDENCY_GATEWAY_MIRROR_REGISTRY="<override-registry-host>"
DEPENDENCY_GATEWAY_MIRROR_PROJECT="public-mirror"
DEPENDENCY_GATEWAY_MIRROR_PLATFORM="linux/amd64"
DEPENDENCY_GATEWAY_MIRROR_SOURCE_PREFIX_MAP_JSON='{"docker.io":["docker.m.daocloud.io","docker.1ms.run","docker.1panel.live","docker.xuanyuan.me"],"mcr.microsoft.com":"m.daocloud.io/mcr.microsoft.com"}'
DEPENDENCY_GATEWAY_MIRROR_TARGET_TLS_VERIFY="true"
DEPENDENCY_GATEWAY_MIRROR_CONCURRENCY="4"
# DEPENDENCY_GATEWAY_MIRROR_UPSTREAM_PROXY="http://<proxy-host>:<proxy-port>"
# DEPENDENCY_GATEWAY_MIRROR_DIRECT_UPSTREAM_WITH_PROXY="true"
